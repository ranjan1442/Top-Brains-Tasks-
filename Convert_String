using System;
using System.Text;
class ConvertString
{
    public static void Main3(string[] args)
    {
        Console.WriteLine("Enter string");
        string str=Console.ReadLine();

        string s=str.Trim();
        StringBuilder s1=new StringBuilder(s);

        for(int i=s1.Length-1; i>0; i--)
        {
            if(s1[i]==' ' && ((int) s1[i+1]) > 96) 
            {
                s1[i+1] = (char) ((int)s1[i+1] -32);
            }
             if(s1[i]==s[i-1])
             {
                s1.Remove(i,1);
             }
        }

      if(((int) s1[0]) > 96) 
      { 
        s1[0] = (char) ((int)s1[0] -32);
      }
        Console.WriteLine($"string after making changes {s1}");

    }
}
